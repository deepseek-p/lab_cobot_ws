<?xml version="1.0"?>
<!--
  Lab standard environment (Gazebo Classic): five functional zones plus
  a dedicated home bay. The semantic layout follows the traction-drive
  laboratory brief rather than a single-row toy staging.
-->
<sdf version="1.6">
  <world name="lab">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>
    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.82 0.82 0.82 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.28 0.24 -0.93</direction>
    </light>
    <scene>
      <ambient>0.52 0.52 0.52 1</ambient>
      <background>0.85 0.87 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.78 0.79 0.80 1</ambient>
            <diffuse>0.88 0.89 0.90 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <shininess>80</shininess>
          </material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="c_n"><pose>0 7 0.5 0 0 0</pose><geometry><box><size>14 0.1 1</size></box></geometry></collision>
        <visual name="v_n"><pose>0 7 0.5 0 0 0</pose><geometry><box><size>14 0.1 1</size></box></geometry><material><diffuse>0.70 0.72 0.78 1</diffuse></material></visual>
        <collision name="c_s"><pose>0 -7 0.5 0 0 0</pose><geometry><box><size>14 0.1 1</size></box></geometry></collision>
        <visual name="v_s"><pose>0 -7 0.5 0 0 0</pose><geometry><box><size>14 0.1 1</size></box></geometry><material><diffuse>0.70 0.72 0.78 1</diffuse></material></visual>
        <collision name="c_e"><pose>7 0 0.5 0 0 0</pose><geometry><box><size>0.1 14 1</size></box></geometry></collision>
        <visual name="v_e"><pose>7 0 0.5 0 0 0</pose><geometry><box><size>0.1 14 1</size></box></geometry><material><diffuse>0.70 0.72 0.78 1</diffuse></material></visual>
        <collision name="c_w"><pose>-7 0 0.5 0 0 0</pose><geometry><box><size>0.1 14 1</size></box></geometry></collision>
        <visual name="v_w"><pose>-7 0 0.5 0 0 0</pose><geometry><box><size>0.1 14 1</size></box></geometry><material><diffuse>0.70 0.72 0.78 1</diffuse></material></visual>
      </link>
    </model>

        <model name="station_a_table">
          <static>true</static>
          <pose>-4.30 3.80 0 0 0 0</pose>
          <link name="link">
            <collision name="collision">
              <pose>0 0 0.375 0 0 0</pose>
              <geometry><box><size>1.6 1.2 0.75</size></box></geometry>
              <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
            </collision>
            <visual name="visual">
              <pose>0 0 0.375 0 0 0</pose>
              <geometry><box><size>1.6 1.2 0.75</size></box></geometry>
              <material>
                <ambient>0.22 0.28 0.33 1</ambient>
                <diffuse>0.34 0.44 0.50 1</diffuse>
                <specular>0.06 0.06 0.06 1</specular>
                <shininess>8</shininess>
              </material>
            </visual>
          </link>
        </model>

        <model name="tooling_zone_table">
          <static>true</static>
          <pose>-4.10 -2.30 0 0 0 0</pose>
          <link name="link">
            <collision name="collision">
              <pose>0 0 0.375 0 0 0</pose>
              <geometry><box><size>1.6 1.2 0.75</size></box></geometry>
              <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
            </collision>
            <visual name="visual">
              <pose>0 0 0.375 0 0 0</pose>
              <geometry><box><size>1.6 1.2 0.75</size></box></geometry>
              <material>
                <ambient>0.36 0.24 0.10 1</ambient>
                <diffuse>0.62 0.38 0.16 1</diffuse>
                <specular>0.06 0.06 0.06 1</specular>
                <shininess>8</shininess>
              </material>
            </visual>
          </link>
        </model>

        <model name="aging_zone_table">
          <static>true</static>
          <pose>0.20 4.20 0 0 0 0</pose>
          <link name="link">
            <collision name="collision">
              <pose>0 0 0.375 0 0 0</pose>
              <geometry><box><size>1.6 1.2 0.75</size></box></geometry>
              <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
            </collision>
            <visual name="visual">
              <pose>0 0 0.375 0 0 0</pose>
              <geometry><box><size>1.6 1.2 0.75</size></box></geometry>
              <material>
                <ambient>0.33 0.16 0.12 1</ambient>
                <diffuse>0.60 0.25 0.20 1</diffuse>
                <specular>0.06 0.06 0.06 1</specular>
                <shininess>8</shininess>
              </material>
            </visual>
          </link>
        </model>

        <model name="station_b_table">
          <static>true</static>
          <pose>0.30 -1.70 0 0 0 0</pose>
          <link name="link">
            <collision name="collision">
              <pose>0 0 0.375 0 0 0</pose>
              <geometry><box><size>1.6 1.2 0.75</size></box></geometry>
              <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
            </collision>
            <visual name="visual">
              <pose>0 0 0.375 0 0 0</pose>
              <geometry><box><size>1.6 1.2 0.75</size></box></geometry>
              <material>
                <ambient>0.10 0.25 0.18 1</ambient>
                <diffuse>0.16 0.48 0.30 1</diffuse>
                <specular>0.06 0.06 0.06 1</specular>
                <shininess>8</shininess>
              </material>
            </visual>
          </link>
        </model>

        <model name="home_zone_pad">
          <static>true</static>
          <pose>4.50 -4.20 0 0 0 0</pose>
          <link name="link">
            <visual name="pad_fill">
              <pose>0 0 0.002 0 0 0</pose>
              <geometry><box><size>1.00 0.90 0.004</size></box></geometry>
              <material>
                <ambient>0.09 0.18 0.25 0.95</ambient>
                <diffuse>0.14 0.28 0.38 0.95</diffuse>
                <specular>0.04 0.04 0.04 1</specular>
              </material>
            </visual>
            <visual name="pad_border_n">
              <pose>0 0.44 0.004 0 0 0</pose>
              <geometry><box><size>1.00 0.02 0.008</size></box></geometry>
              <material><ambient>0.92 0.92 0.94 1</ambient><diffuse>0.96 0.96 0.98 1</diffuse></material>
            </visual>
            <visual name="pad_border_s">
              <pose>0 -0.44 0.004 0 0 0</pose>
              <geometry><box><size>1.00 0.02 0.008</size></box></geometry>
              <material><ambient>0.92 0.92 0.94 1</ambient><diffuse>0.96 0.96 0.98 1</diffuse></material>
            </visual>
            <visual name="pad_border_e">
              <pose>0.49 0 0.004 0 0 0</pose>
              <geometry><box><size>0.02 0.86 0.008</size></box></geometry>
              <material><ambient>0.92 0.92 0.94 1</ambient><diffuse>0.96 0.96 0.98 1</diffuse></material>
            </visual>
            <visual name="pad_border_w">
              <pose>-0.49 0 0.004 0 0 0</pose>
              <geometry><box><size>0.02 0.86 0.008</size></box></geometry>
              <material><ambient>0.92 0.92 0.94 1</ambient><diffuse>0.96 0.96 0.98 1</diffuse></material>
            </visual>
            <visual name="pad_centerline">
              <pose>0 0 0.004 0 0 0</pose>
              <geometry><box><size>0.14 0.56 0.008</size></box></geometry>
              <material><ambient>0.92 0.92 0.94 1</ambient><diffuse>0.96 0.96 0.98 1</diffuse></material>
            </visual>
          </link>
        </model>

    <include>
      <uri>model://aruco_sample</uri>
      <name>aruco_sample</name>
      <pose>-4.16 3.46 0.785 0 0 0.10</pose>
    </include>
    <include>
      <uri>model://material_cube_red</uri>
      <name>material_cube_red</name>
      <pose>-4.50 3.30 0.785 0 0 0</pose>
    </include>
    <include>
      <uri>model://material_cube_green</uri>
      <name>material_cube_green</name>
      <pose>-4.30 3.30 0.785 0 0 0</pose>
    </include>
    <include>
      <uri>model://material_cube_blue</uri>
      <name>material_cube_blue</name>
      <pose>-4.50 3.52 0.785 0 0 0</pose>
    </include>
    <include>
      <uri>model://material_cube_yellow</uri>
      <name>material_cube_yellow</name>
      <pose>-4.30 3.52 0.785 0 0 0</pose>
    </include>
    <include>
      <uri>model://fixture_box_plain</uri>
      <name>tooling_fixture_box</name>
      <pose>-3.88 -2.04 0.758 0 0 -0.28</pose>
    </include>
    <include>
      <uri>model://tooling_hand_tools</uri>
      <name>tooling_hand_tools</name>
      <pose>-4.36 -1.96 0.761 0 0 0.12</pose>
    </include>
    <include>
      <uri>model://pcb_test_fixture</uri>
      <name>board_test_fixture</name>
      <pose>-4.70 -2.60 0.7776 0 0 0.05</pose>
    </include>
    <include>
      <uri>model://safety_probe_kit</uri>
      <name>high_voltage_probe_kit</name>
      <pose>-4.30 -2.60 0.75 0 0 -0.15</pose>
    </include>
    <include>
      <uri>model://igbt_module_plain</uri>
      <name>material_spare_igbt</name>
      <pose>-3.62 -2.60 0.753 0 0 0.38</pose>
    </include>
    <include>
      <uri>model://aging_rack</uri>
      <name>aging_rack</name>
      <pose>0.20 3.88 0.80 0 0 0</pose>
    </include>
    <include>
      <uri>model://pcb_board</uri>
      <name>pcb_board</name>
      <pose>0.55 4.30 0.75 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube_rack</uri>
      <name>test_tube_rack_1</name>
      <pose>0.48 -1.95 0.75 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube_rack</uri>
      <name>test_tube_rack_2</name>
      <pose>0.12 -1.95 0.75 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube</uri>
      <name>test_tube_1</name>
      <pose>0.36 -1.95 0.762 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube</uri>
      <name>test_tube_2</name>
      <pose>0.42 -1.95 0.762 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube</uri>
      <name>test_tube_3</name>
      <pose>0.48 -1.95 0.762 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube</uri>
      <name>test_tube_4</name>
      <pose>0.54 -1.95 0.762 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube</uri>
      <name>test_tube_5</name>
      <pose>0.60 -1.95 0.762 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube</uri>
      <name>test_tube_6</name>
      <pose>0.00 -1.95 0.762 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube</uri>
      <name>test_tube_7</name>
      <pose>0.06 -1.95 0.762 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube</uri>
      <name>test_tube_8</name>
      <pose>0.18 -1.95 0.762 0 0 0</pose>
    </include>
    <include>
      <uri>model://test_tube</uri>
      <name>test_tube_9</name>
      <pose>0.24 -1.95 0.762 0 0 0</pose>
    </include>
    <include>
      <uri>model://graduated_cylinder</uri>
      <name>graduated_cylinder</name>
      <pose>-0.30 -1.95 0.82 0 0 0</pose>
    </include>
    <include>
      <uri>model://beaker</uri>
      <name>beaker_2</name>
      <pose>-0.15 -1.95 0.75 0 0 0</pose>
    </include>
    <include>
      <uri>model://beaker</uri>
      <name>beaker_1</name>
      <pose>0.72 -1.95 0.75 0 0 0</pose>
    </include>
    <include>
      <uri>model://erlenmeyer_flask</uri>
      <name>erlenmeyer_flask</name>
      <pose>0.88 -1.95 0.75 0 0 0</pose>
    </include>
    
    <include>
      <uri>model://high_voltage_zone</uri>
      <name>high_voltage_zone</name>
      <pose>4.36 2.90 0 0 0 0.12</pose>
    </include>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
  </world>
</sdf>
