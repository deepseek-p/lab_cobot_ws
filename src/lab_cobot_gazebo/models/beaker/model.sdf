<?xml version="1.0"?>
<sdf version="1.6">
  <!-- 烧杯(可抓取):淡蓝玻璃色开口圆柱,直径 0.06 < 夹爪开度。 -->
  <model name="beaker">
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>5.29e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>5.29e-5</iyy><iyz>0</iyz><izz>2.25e-5</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.030</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.030</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.75 0.90 1</ambient>
          <diffuse>0.70 0.85 0.95 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
          <shininess>96</shininess>
        </material>
      </visual>
    </link>
  </model>
</sdf>
