<?xml version="1.0"?>
<sdf version="1.6">
  <!-- 烧杯(可抓取):真玻璃材质开口圆柱,直径 0.06 < 夹爪开度,动态模型。
       玻璃:transparency 0.35 + double_sided + 高 specular/shininess;
       管口 + 3 条刻度环 + 内部淡蓝液体,高保真。 -->
  <model name="beaker">
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>5.29e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>5.29e-5</iyy><iyz>0</iyz><izz>2.25e-5</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.030</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- 玻璃杯身 -->
      <visual name="visual">
        <transparency>0.35</transparency>
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.030</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.75 0.88 0.95 0.4</ambient>
          <diffuse>0.88 0.95 1.0 0.4</diffuse>
          <specular>1.0 1.0 1.0 1.0</specular>
          <shininess>128</shininess>
          <double_sided>true</double_sided>
        </material>
      </visual>

      <!-- 杯口(视觉厚边) -->
      <visual name="visual_rim">
        <transparency>0.25</transparency>
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.75 0.88 0.95 0.5</ambient>
          <diffuse>0.88 0.95 1.0 0.5</diffuse>
          <specular>1.0 1.0 1.0 1.0</specular>
          <shininess>128</shininess>
          <double_sided>true</double_sided>
        </material>
      </visual>

      <!-- 3 条刻度环(视觉) -->
      <visual name="visual_scale_1">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.031</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.20 0.25 0.35 1</ambient>
          <diffuse>0.30 0.36 0.50 1</diffuse>
        </material>
      </visual>
      <visual name="visual_scale_2">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.031</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.20 0.25 0.35 1</ambient>
          <diffuse>0.30 0.36 0.50 1</diffuse>
        </material>
      </visual>
      <visual name="visual_scale_3">
        <pose>0 0 0.07 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.031</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.20 0.25 0.35 1</ambient>
          <diffuse>0.30 0.36 0.50 1</diffuse>
        </material>
      </visual>

      <!-- 内部淡蓝液体(视觉) -->
      <visual name="visual_liquid">
        <transparency>0.20</transparency>
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.024</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.40 0.65 0.85 1</ambient>
          <diffuse>0.60 0.80 0.95 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
          <shininess>32</shininess>
        </material>
      </visual>
    </link>
  </model>
</sdf>
