<?xml version="1.0"?>
<sdf version="1.6">
  <!-- 板卡(可抓取):PCB 板面 + 底部支撑脚自立,金手指视觉,板厚 0.008 < 夹爪开度可侧向夹取。 -->
  <model name="pcb_board">
    <link name="link">
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>1.8e-4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.6e-4</iyy><iyz>0</iyz><izz>3.0e-4</izz>
        </inertia>
      </inertial>
      <!-- 底部支撑脚(自立) -->
      <collision name="collision_base">
        <pose>0 0 0.0075 0 0 0</pose>
        <geometry><box><size>0.12 0.16 0.015</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual_base">
        <pose>0 0 0.0075 0 0 0</pose>
        <geometry><box><size>0.12 0.16 0.015</size></box></geometry>
        <material>
          <ambient>0.25 0.25 0.28 1</ambient>
          <diffuse>0.42 0.44 0.48 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
          <shininess>24</shininess>
        </material>
      </visual>
      <!-- PCB 板面(立起,朝 ±y) -->
      <collision name="collision_board">
        <pose>0 0 0.078 0 0 0</pose>
        <geometry><box><size>0.18 0.008 0.12</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual_board">
        <pose>0 0 0.078 0 0 0</pose>
        <geometry><box><size>0.18 0.008 0.12</size></box></geometry>
        <material>
          <ambient>0.05 0.35 0.18 1</ambient>
          <diffuse>0.08 0.55 0.28 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
          <shininess>32</shininess>
        </material>
      </visual>
      <!-- 金手指条(顶缘视觉) -->
      <visual name="visual_gold_fingers">
        <pose>0 0 0.1385 0 0 0</pose>
        <geometry><box><size>0.18 0.010 0.012</size></box></geometry>
        <material>
          <ambient>0.78 0.62 0.20 1</ambient>
          <diffuse>0.95 0.78 0.28 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <shininess>64</shininess>
        </material>
      </visual>
      <!-- 板面元件小凸起(视觉) -->
      <visual name="visual_component">
        <pose>0.04 0 0.09 0 0 0</pose>
        <geometry><box><size>0.03 0.012 0.015</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.12 1</ambient>
          <diffuse>0.18 0.18 0.20 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
