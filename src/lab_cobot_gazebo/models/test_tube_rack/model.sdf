<?xml version="1.0"?>
<sdf version="1.6">
  <!-- 试管架(静态环境道具):木块钻圆孔造型。
       视觉 = 实木块 + 5 个深色圆形孔口,呈现经典"木块圆孔"试管架;
       碰撞 = 隐藏内部的方形导孔(前/后墙 + 4 隔墙 + 2 端板),稳定引导外径 0.022 的玻璃试管下插。 -->
  <model name="test_tube_rack">
    <static>true</static>
    <link name="link">
      <!-- 底座板(顶面 z=0.012,试管即落于此) -->
      <collision name="collision_base">
        <pose>0 0 0.006 0 0 0</pose>
        <geometry><box><size>0.31 0.10 0.012</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual_base">
        <pose>0 0 0.006 0 0 0</pose>
        <geometry><box><size>0.31 0.10 0.012</size></box></geometry>
        <material>
          <ambient>0.30 0.18 0.07 1</ambient>
          <diffuse>0.50 0.30 0.13 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
          <shininess>8</shininess>
        </material>
      </visual>

      <!-- ── 碰撞:木块内的方形导孔结构(z 中心 0.037,高 0.050) ── -->
      <!-- 前墙(y∈[0.022,0.050]) -->
      <collision name="collision_wall_front">
        <pose>0 0.036 0.037 0 0 0</pose>
        <geometry><box><size>0.31 0.028 0.050</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <!-- 后墙(y∈[-0.050,-0.022]) -->
      <collision name="collision_wall_back">
        <pose>0 -0.036 0.037 0 0 0</pose>
        <geometry><box><size>0.31 0.028 0.050</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <!-- 4 条隔墙,分隔 5 个导孔 -->
      <collision name="collision_divider_1">
        <pose>-0.09 0 0.037 0 0 0</pose>
        <geometry><box><size>0.020 0.044 0.050</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <collision name="collision_divider_2">
        <pose>-0.03 0 0.037 0 0 0</pose>
        <geometry><box><size>0.020 0.044 0.050</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <collision name="collision_divider_3">
        <pose>0.03 0 0.037 0 0 0</pose>
        <geometry><box><size>0.020 0.044 0.050</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <collision name="collision_divider_4">
        <pose>0.09 0 0.037 0 0 0</pose>
        <geometry><box><size>0.020 0.044 0.050</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <!-- 两端封板 -->
      <collision name="collision_endcap_1">
        <pose>-0.145 0 0.037 0 0 0</pose>
        <geometry><box><size>0.020 0.044 0.050</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <collision name="collision_endcap_2">
        <pose>0.145 0 0.037 0 0 0</pose>
        <geometry><box><size>0.020 0.044 0.050</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>

      <!-- ── 视觉:实木块(z∈[0.012,0.062]),管下段被木块遮住,呈现"插入孔中" ── -->
      <visual name="visual_block">
        <pose>0 0 0.037 0 0 0</pose>
        <geometry><box><size>0.31 0.10 0.050</size></box></geometry>
        <material>
          <ambient>0.30 0.18 0.07 1</ambient>
          <diffuse>0.50 0.30 0.13 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
          <shininess>8</shininess>
        </material>
      </visual>

      <!-- 5 个深色圆形孔口(视觉),孔心 x=-0.12..0.12 -->
      <visual name="visual_hole_1">
        <pose>-0.12 0 0.064 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.08 0.08 0.10 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <shininess>4</shininess>
        </material>
      </visual>
      <visual name="visual_hole_2">
        <pose>-0.06 0 0.064 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.08 0.08 0.10 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <shininess>4</shininess>
        </material>
      </visual>
      <visual name="visual_hole_3">
        <pose>0 0 0.064 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.08 0.08 0.10 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <shininess>4</shininess>
        </material>
      </visual>
      <visual name="visual_hole_4">
        <pose>0.06 0 0.064 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.08 0.08 0.10 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <shininess>4</shininess>
        </material>
      </visual>
      <visual name="visual_hole_5">
        <pose>0.12 0 0.064 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.08 0.08 0.10 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <shininess>4</shininess>
        </material>
      </visual>

      <!-- 白色标签条(仅视觉) -->
      <visual name="visual_label">
        <pose>0 0.0505 0.040 0 0 0</pose>
        <geometry><box><size>0.20 0.006 0.004</size></box></geometry>
        <material>
          <ambient>0.90 0.90 0.92 1</ambient>
          <diffuse>0.96 0.96 0.98 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
          <shininess>8</shininess>
        </material>
      </visual>
    </link>
  </model>
</sdf>
