<?xml version="1.0"?>
<sdf version="1.6">
  <!-- 锥形瓶(可抓取):淡绿玻璃色,瓶身 + 细颈,直径 0.07 < 夹爪开度。 -->
  <model name="erlenmeyer_flask">
    <link name="link">
      <inertial>
        <mass>0.06</mass>
        <inertia>
          <ixx>9.04e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>9.04e-5</iyy><iyz>0</iyz><izz>3.68e-5</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual_body">
        <transparency>0.30</transparency>
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.75 0.60 0.4</ambient>
          <diffuse>0.70 0.88 0.75 0.4</diffuse>
          <specular>1.0 1.0 1.0 1.0</specular>
          <shininess>128</shininess>
          <double_sided>true</double_sided>
        </material>
      </visual>
      <visual name="visual_neck">
        <transparency>0.30</transparency>
        <pose>0 0 0.085 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.75 0.60 0.4</ambient>
          <diffuse>0.70 0.88 0.75 0.4</diffuse>
          <specular>1.0 1.0 1.0 1.0</specular>
          <shininess>128</shininess>
          <double_sided>true</double_sided>
