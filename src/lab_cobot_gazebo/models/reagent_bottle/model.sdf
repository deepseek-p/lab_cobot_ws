<?xml version="1.0"?>
<sdf version="1.6">
  <!-- 试剂瓶(可抓取):蓝色圆柱瓶,直径 0.07 < 夹爪开度,动态模型,立于试剂架格内。 -->
  <model name="reagent_bottle">
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.22e-4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.22e-4</iyy><iyz>0</iyz><izz>3.06e-5</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.2 0.8 1</ambient>
          <diffuse>0.1 0.2 0.8 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <shininess>24</shininess>
        </material>
      </visual>
    </link>
  </model>
</sdf>
